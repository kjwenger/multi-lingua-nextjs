# Multi-Lingua Environment Configuration

# Development Mode (logs codes to console instead of sending email)
DEV_MODE=true

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-use-a-long-random-string
JWT_EXPIRY=24h

# Application URL
APP_URL=http://localhost:3456

# Email Configuration (SMTP)
# Only required if DEV_MODE=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=noreply@multi-lingua.com
SMTP_PASSWORD=your-smtp-password

# Session Configuration (optional, defaults to database config)
# SESSION_TIMEOUT_MINUTES=1440

# Database Directory (optional)
# DATA_DIR=/app/data

# LibreTranslate Configuration
# LIBRETRANSLATE_URL=http://libretranslate:5000
# Per-request timeout in ms (default 60000); raise on slow hosts like a Raspberry Pi
# LIBRETRANSLATE_TIMEOUT_MS=60000
# LibreTranslate container: languages to load and gunicorn worker count (see docker-compose.yml)
# LT_LOAD_ONLY=en,de,fr,it,es
# LT_THREADS=2

# Initial Admin Email (optional)
# Used for first-time setup
# INITIAL_ADMIN_EMAIL=admin@multi-lingua.com
